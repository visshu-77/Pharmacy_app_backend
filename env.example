# Copy to .env for local work, and set the same keys in Render -> Environment.
# .env itself is gitignored, so nothing here ever reaches the server by deploy.

# --- Database ---------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/storeflow
# Hosted: your MongoDB Atlas connection string
MONGODB_URI=

# --- App --------------------------------------------------------------
# Where the frontend runs. Several allowed, comma separated. "*" works as a
# wildcard for Vercel previews. Leave empty only in development.
FRONTEND_URL=https://your-app.vercel.app,https://*.vercel.app

# Render sets PORT itself — do not set it there.
PORT=5000

# Long random string used to sign login tokens.
JWT_SECRET_KEY=

# Set to "production" on the live server. Among other things, it stops
# verification codes from being printed to the log instead of emailed.
NODE_ENV=development

# --- Email: signup verification codes ---------------------------------
# Which provider sends email: resend | smtp | auto (default auto).
# "auto" uses Resend once MAIL_FROM is on a domain you have verified,
# otherwise it uses the Gmail account below (which can email anyone).
MAIL_PROVIDER=auto

# Resend (https://resend.com -> API Keys)
RESEND_API_KEY=
# Sender address. "onboarding@resend.dev" only delivers to the Resend account
# owner, so it is for testing only. Once you verify your own domain at
# resend.com -> Domains, change this to e.g. StoreFlow <noreply@yourdomain.com>
MAIL_FROM=StoreFlow <onboarding@resend.dev>

# --- Payments (Razorpay) ----------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gmail sender — used for subscription receipts, and for verification codes
# whenever Resend is not usable. EMAIL_PASSWORD must be a Google "App password"
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal password. Gmail allows roughly 500 emails a day.
EMAIL_USER=
EMAIL_PASSWORD=

# --- AI assistant -----------------------------------------------------
GEMINI_API_KEY=
